{
  "name": "mitm-lab-server",
  "version": "1.0.0",
  "description": "Backend Express (arquitectura hexagonal) del laboratorio MITM. HTTP sin TLS a proposito.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
